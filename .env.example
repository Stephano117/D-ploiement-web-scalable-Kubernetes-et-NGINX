# Facultatif : sans fichier .env, l'application démarre avec les réglages XAMPP ci-dessous.
# Pour changer une valeur, copiez ce fichier en ".env" (Windows : copy .env.example .env).

# MySQL / MariaDB (réglages par défaut de XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rgm

# Compte du studio pour /admin (le mot de passe est mis à jour à chaque redémarrage)
ADMIN_EMAIL=admin@rgm.local
ADMIN_PASSWORD=rgm2026

# À changer avant la mise en ligne : longue phrase aléatoire
SECRET_KEY=remplacez-par-une-longue-phrase-aleatoire

PORT=3000
MAX_UPLOAD_MB=500

# Hébergement avec une base MySQL managée (ex. TiDB Cloud).
# Créer DB_NAME dans le service de base, puis activer TLS et désactiver la création automatique.
DB_SSL=false
DB_AUTO_CREATE=true

# Facultatif : stockage durable des imports sur Cloudflare R2.
# Laisser les quatre valeurs vides pour stocker localement dans uploads/.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
