# Facultatif : sans fichier .env, l'application démarre avec les réglages XAMPP ci-dessous.
# Pour changer une valeur, copiez ce fichier en ".env" (Windows : copy .env.example .env).

# MySQL / MariaDB (réglages par défaut de XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rgm

# Compte du studio pour /admin (le mot de passe est mis à jour à chaque redémarrage)
ADMIN_EMAIL=admin@rgm.local
ADMIN_PASSWORD=rgm2026

# À changer avant la mise en ligne : longue phrase aléatoire
SECRET_KEY=remplacez-par-une-longue-phrase-aleatoire

PORT=3000
MAX_UPLOAD_MB=500
