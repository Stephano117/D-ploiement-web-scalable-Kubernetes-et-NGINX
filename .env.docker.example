# Copy this file to .env.docker and replace every example password/key.
APP_PORT=3000

# These credentials must match the MYSQL_* values supplied to the MySQL service.
DB_NAME=rgm
DB_USER=rgm
DB_PASSWORD=replace-with-a-strong-app-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Studio account. The application updates this account from these values at startup.
ADMIN_EMAIL=admin@rgm.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Use a long, random value. Do not commit .env.docker.
SECRET_KEY=replace-with-a-long-random-secret-key
MAX_UPLOAD_MB=500
